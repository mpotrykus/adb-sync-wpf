<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>adbsync-server</AssemblyName>
    <RootNamespace>AdbSync.Server</RootNamespace>
    <Version>2.0.0-alpha.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdbSync.Engine\AdbSync.Engine.csproj" />
    <ProjectReference Include="..\AdbSync.Contracts\AdbSync.Contracts.csproj" />
    <!-- The UI always builds for browser-wasm; a -a/-r passed to the server publish must not reach it. -->
    <ProjectReference Include="..\AdbSync.Web\AdbSync.Web.csproj" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AdbSync.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.34" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

</Project>
