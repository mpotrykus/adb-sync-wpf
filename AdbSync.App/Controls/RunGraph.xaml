<UserControl x:Class="AdbSync.App.Controls.RunGraph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="GraphCanvas" Background="Transparent" MouseLeftButtonUp="OnCanvasClicked"/>
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Style="{StaticResource EmptyStateText}" VerticalAlignment="Center" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="16,0" Visibility="Collapsed"/>
    </Grid>
</UserControl>
